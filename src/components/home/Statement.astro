---
import type { HomeContent } from "../../i18n/home";
import Icon from "./Icon.astro";

interface Props {
  t: HomeContent;
}
const { t } = Astro.props;
const chips = [
  { icon: "phone", cls: "bg-amber-soft text-amber-ink", rot: "-rotate-6" },
  { icon: "chat", cls: "bg-green-soft text-green", rot: "rotate-6" },
  { icon: "sparkle", cls: "bg-sky-50 text-sky-800", rot: "-rotate-6" },
  { icon: "database", cls: "bg-ink text-white", rot: "rotate-6" },
] as const;
---

<section class="px-5 pt-24 pb-16 lg:pt-[200px] lg:pb-[140px]">
  <div class="mx-auto flex max-w-[1060px] flex-col items-center text-center">
    <div class="flex gap-2.5" aria-hidden="true" data-reveal-stagger>
      {chips.map((c) => (
        <span class:list={["grid size-11 place-items-center rounded-[14px] lg:size-16 lg:rounded-[20px]", c.cls, c.rot]}>
          <Icon name={c.icon} size={20} class="lg:size-7" />
        </span>
      ))}
    </div>
    <p class="mt-6 text-[26px] leading-[1.38] font-medium tracking-[-0.015em] text-ink lg:mt-10 lg:text-[52px] lg:leading-[1.3]" data-reveal>
      {t.statement.lead}<span class="text-ink/25">{t.statement.rest}</span>
    </p>
  </div>
</section>

<section id="integrations" class="px-5 pb-[120px] lg:pb-[220px]">
  <div class="mx-auto flex max-w-[1100px] flex-col items-center gap-5 text-center lg:gap-7">
    <p class="text-[14px] text-ink-muted lg:text-[16px]">{t.works.label}</p>
    <ul class="flex flex-wrap justify-center gap-x-5 gap-y-3 lg:gap-x-16" dir="ltr">
      {t.works.names.map((n) => <li class="text-[17px] font-semibold tracking-[-0.01em] text-[#9aa3b2] lg:text-[24px]">{n}</li>)}
    </ul>
  </div>
</section>
