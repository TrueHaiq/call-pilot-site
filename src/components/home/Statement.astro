---
// Scroll-linked statement: words and channel icons light up in reading order as the section scrolls by.
// One custom property (--p, 0 to 1) drives every token; each token knows its index (--i).
import type { HomeContent } from "../../i18n/home";
import Icon from "./Icon.astro";

interface Props {
  t: HomeContent;
}
const { t } = Astro.props;

const iconStyle = {
  phone: { cls: "bg-amber-soft text-amber-ink", rot: 6 },
  chat: { cls: "bg-green-soft text-green", rot: -6 },
  sparkle: { cls: "bg-sky-50 text-sky-800", rot: 6 },
  database: { cls: "bg-ink text-white", rot: -6 },
} as const;

type Token =
  | { kind: "word"; text: string; i: number }
  | { kind: "icon"; icon: keyof typeof iconStyle; i: number }
  | { kind: "br" };
const tokens: Token[] = [];
let n = 0;
for (const part of t.statement.parts) {
  if (typeof part === "string") {
    for (const w of part.split(/\s+/).filter(Boolean)) tokens.push({ kind: "word", text: w, i: n++ });
  } else if ("br" in part) {
    tokens.push({ kind: "br" });
  } else {
    tokens.push({ kind: "icon", icon: part.icon, i: n++ });
  }
}
const icons = tokens.filter((x): x is Extract<Token, { kind: "icon" }> => x.kind === "icon");
const plain = t.statement.parts.filter((p): p is string => typeof p === "string").join(" ");
---

<section class="px-5 pt-[72px] pb-16 lg:pt-40 lg:pb-[140px]">
  <!-- Mobile: the icons sit in a row above the text (mobile design) -->
  <div class="mb-6 flex justify-center gap-2.5 lg:hidden" aria-hidden="true" data-reveal-stagger>
    {icons.map((ic) => (
      <span class:list={["grid size-11 place-items-center rounded-[14px]", iconStyle[ic.icon].cls]} style={`rotate:${iconStyle[ic.icon].rot}deg`}>
        <Icon name={ic.icon} size={20} />
      </span>
    ))}
  </div>
  <p
    class="statement mx-auto select-none max-w-[1120px] text-center text-[26px] leading-[1.42] font-medium tracking-[-0.015em] text-ink lg:text-[52px] lg:leading-[82px] lg:tracking-[-0.8px]"
    style={`--n:${n}`}
    aria-label={plain}
    data-statement
  >
    {/* Kept on one line: line breaks inside this expression would render as extra spaces between words. */}
    {tokens.map((tok) => tok.kind === "br" ? <br class="hidden lg:inline" /> : tok.kind === "word" ? <span class="st-w" style={`--i:${tok.i}`} aria-hidden="true">{tok.text + " "}</span> : <span class:list={["st-i hidden lg:inline-flex", iconStyle[tok.icon].cls]} style={`--i:${tok.i};--rot:${iconStyle[tok.icon].rot}deg`} aria-hidden="true"><Icon name={tok.icon} size={28} /></span>)}
  </p>
</section>

<section id="integrations" class="pb-[120px] lg:pb-[220px]">
  <div class="mx-auto flex max-w-[1100px] flex-col items-center gap-5 text-center lg:gap-7">
    <p class="px-5 text-[14px] text-ink-muted lg:text-[16px]">{t.works.label}</p>
    <!-- Marquee: two identical runs scroll as one loop; edges fade out; pauses on hover. -->
    <div class="marquee group w-full overflow-hidden select-none" dir="ltr">
      <div class="marquee-track flex w-max group-hover:[animation-play-state:paused]">
        {[0, 1].map((copy) => (
          <ul class="flex shrink-0 items-center gap-12 pe-12 lg:gap-20 lg:pe-20" aria-hidden={copy === 1 ? "true" : undefined}>
            {t.works.names.map((n) => <li class="text-[19px] font-semibold tracking-[-0.01em] whitespace-nowrap text-[#9aa3b2] lg:text-[24px]">{n}</li>)}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Without JS (and with reduced motion) the statement is fully lit: readable first, effect second. */
  .statement {
    --p: 1;
  }
  :global(html.js) .statement {
    --p: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .statement {
      --p: 1;
    }
  }

  .marquee {
    mask-image: linear-gradient(to right, transparent, black 14%, black 86%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 14%, black 86%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee 32s linear infinite;
    }
  }
  /* Reduced motion: no movement; the names wrap and centre like a static row. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
      -webkit-mask-image: none;
    }
    .marquee-track {
      width: 100%;
      justify-content: center;
    }
    .marquee-track > ul:last-child {
      display: none;
    }
    .marquee-track > ul {
      flex-wrap: wrap;
      justify-content: center;
      padding-inline: 1.25rem;
      row-gap: 0.75rem;
    }
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Each token ramps over ~2.4 token-steps, so the highlight reads as a soft continuous sweep. */
  .st-w,
  .st-i {
    --t: clamp(0, calc((var(--p) * (var(--n) + 3) - var(--i)) * 0.42), 1);
  }
  .st-w {
    opacity: calc(0.16 + 0.84 * var(--t));
  }

  /* Inline channel icon (desktop): 64px chip on 52px text, 16px from the words, tilted ±6deg. */
  .st-i {
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin-inline: 4px 16px;
    border-radius: 20px;
    vertical-align: middle;
    position: relative;
    top: -4px;
    opacity: calc(0.3 + 0.7 * var(--t));
    scale: calc(0.82 + 0.18 * var(--t));
    rotate: calc(var(--rot) * var(--t));
  }
</style>

<script>
  import { scroll } from "motion";
  import { reducedMotion } from "../../scripts/motion";

  const el = document.querySelector<HTMLElement>("[data-statement]");
  if (el && !reducedMotion()) {
    // 0 when the paragraph's top reaches 85% of the viewport, 1 when its bottom reaches 40%.
    scroll((p: number) => el.style.setProperty("--p", p.toFixed(4)), {
      target: el,
      offset: ["start 0.85", "end 0.4"],
    });
  }
</script>
