---
import type { HomeContent } from "../../i18n/home";
import AppWindow from "./AppWindow.astro";
import FloatCards from "./FloatCards.astro";
import Cloud from "./Cloud.astro";

interface Props {
  t: HomeContent;
}
const { t } = Astro.props;
---

<section id="product" class="relative overflow-hidden" style="background: var(--sky-gradient)">
  <!-- Sun glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-[520px] h-[1100px] w-[1300px] opacity-60 ltr:-right-[520px] rtl:-left-[520px]"
    style="background: radial-gradient(closest-side, rgb(255 255 255 / 0.85), rgb(255 244 220 / 0.55) 12%, rgb(255 230 184 / 0.18) 35%, transparent 100%)"
  ></div>

  <div class="relative z-10 mx-auto flex max-w-[1320px] flex-col items-center px-5 pt-[96px] text-center text-white lg:pt-[150px]">
    <p class="glass-dark inline-flex items-center gap-2 rounded-full py-1.5 ps-1.5 pe-4 text-[13px] lg:text-[14px]" data-hero-item>
      <span class="rounded-full bg-amber px-2.5 py-0.5 text-[12px] font-semibold text-ink">{t.hero.tag}</span>
      {t.hero.badge}
    </p>
    <h1 class="mt-6 text-[34px] leading-[1.24] font-bold tracking-[-0.018em] lg:mt-8 lg:text-display lg:leading-[1.24]" data-hero-item>
      {t.hero.title[0]}<br />{t.hero.title[1]}
    </h1>
    <p class="mt-5 max-w-[640px] text-[16px] leading-[1.6] text-balance text-white/90 lg:mt-6 lg:text-[20px]" data-hero-item>{t.hero.sub}</p>
    <div class="mt-7 flex w-full max-w-[335px] flex-col gap-2.5 sm:w-auto sm:max-w-none sm:flex-row lg:mt-9 lg:gap-3" data-hero-item>
      <a href="#demo" class="rounded-full bg-white px-8 py-4 text-[16px] font-medium text-ink shadow-[0_14px_30px_-10px_rgb(14_58_128/0.45)] transition-transform active:scale-[0.97]">
        {t.hero.primary}
      </a>
      <a href="#pricing" class="glass-dark rounded-full px-8 py-4 text-[16px] font-medium text-white transition-transform active:scale-[0.97]">
        {t.hero.secondary}
      </a>
    </div>
  </div>

  <!-- Desktop composition (design: 1440 x 1240 frame, window at y630) -->
  <div class="relative mx-auto mt-[73px] hidden h-[610px] w-[1120px] lg:block" role="img" aria-label={t.hero.productLabel}>
    <div aria-hidden="true">
      <Cloud name="far-l" x={-791} y={-257} />
      <Cloud name="far-r" x={324} y={-296} />
      <Cloud name="bank-l" x={-930} y={-58} />
      <Cloud name="bank-r" x={11} y={-25} />
      <div class="relative" data-hero-window><AppWindow t={t.app} /></div>
      <Cloud name="floor" x={-952} y={261} class="z-10" />
      <FloatCards t={t.floats} which="call" class="float absolute -top-[90px] -end-[90px] z-20" style="--d:0s" />
      <FloatCards t={t.floats} which="whatsapp" class="float absolute -top-[130px] -start-[110px] z-20" style="--d:1.2s" />
      <FloatCards t={t.floats} which="summary" class="float absolute top-[250px] -end-[106px] z-20" style="--d:2.1s" />
      <FloatCards t={t.floats} which="crm" class="float absolute top-[242px] -start-[112px] z-20" style="--d:0.6s" />
    </div>
  </div>

  <!-- Mobile and tablet composition: dashboard cropped to its start side, two floating cards -->
  <div class="relative mt-10 h-[372px] lg:hidden" role="img" aria-label={t.hero.productLabel} style="--cs:0.55">
    <div aria-hidden="true">
      <Cloud name="far-l" x={-300} y={-30} />
      <Cloud name="far-r" x={60} y={-60} />
      <div class="absolute top-[32px] start-4 scale-[0.62] ltr:origin-top-left rtl:origin-top-right md:scale-[0.8]">
        <AppWindow t={t.app} />
      </div>
      <Cloud name="floor" x={-1000} y={330} class="z-10" />
      <FloatCards t={t.floats} which="call" class="float absolute top-0 end-3.5 z-20 scale-[0.9] ltr:origin-top-right rtl:origin-top-left" style="--d:0s" />
      <FloatCards t={t.floats} which="whatsapp" class="float absolute top-[236px] start-3.5 z-20 scale-[0.88] ltr:origin-top-left rtl:origin-top-right" style="--d:1.2s" />
    </div>
  </div>
</section>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .float {
      animation: drift 7s ease-in-out infinite;
      animation-delay: var(--d);
    }
    .wave-bar {
      animation: wave 1.1s ease-in-out infinite alternate;
    }
    .wave-bar:nth-child(3n) { animation-delay: -0.4s; }
    .wave-bar:nth-child(3n + 1) { animation-delay: -0.8s; }
  }
  @keyframes drift {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -8px; }
  }
  @keyframes wave {
    from { transform: scaleY(0.45); }
    to { transform: scaleY(1); }
  }
</style>
