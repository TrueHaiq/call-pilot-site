---
import type { HomeContent } from "../../i18n/home";
import AppWindow from "./AppWindow.astro";
import FloatCards from "./FloatCards.astro";
import Cloud from "./Cloud.astro";

interface Props {
  t: HomeContent;
}
const { t } = Astro.props;
---

<section id="hero" class="hero-sky relative overflow-hidden max-lg:flex max-lg:min-h-svh max-lg:flex-col max-lg:justify-center">
  <!-- Sun glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-[520px] h-[1100px] w-[1300px] opacity-60 ltr:-right-[520px] rtl:-left-[520px]"
    style="background: radial-gradient(closest-side, rgb(255 255 255 / 0.85), rgb(255 244 220 / 0.55) 12%, rgb(255 230 184 / 0.18) 35%, transparent 100%)"
  ></div>

  <div class="relative z-10 mx-auto flex w-full max-w-[1320px] flex-col items-center px-5 pt-28 pb-36 text-center text-white lg:pt-[150px] lg:pb-0">
    <p class="glass-dark inline-flex items-center gap-2 rounded-full py-1.5 ps-1.5 pe-4 text-[13px] lg:text-[14px]" data-hero-item>
      <span class="rounded-full bg-amber px-2.5 py-0.5 text-[12px] font-semibold text-ink">{t.hero.tag}</span>
      {t.hero.badge}
    </p>
    <h1 class="mt-[18px] text-[34px] leading-[42px] font-bold tracking-[-0.6px] md:text-[54px] md:leading-[62px] lg:mt-[26px] lg:text-[84px] lg:leading-[87px] lg:tracking-[-1.5px]" data-hero-item data-hero-lead>
      {t.hero.title[0]}<br />{t.hero.title[1]}
    </h1>
    <p class="mt-[18px] max-w-[640px] text-[16px] leading-[1.6] text-balance text-white/90 md:text-[18px] lg:mt-[26px] lg:max-w-[700px] lg:text-[20px] lg:leading-[31px]" data-hero-item>{t.hero.sub.split(", ").map((part, i, all) => <>{part}{i < all.length - 1 && <>,<br class="hidden lg:inline" /> </>}</>)}</p>
    <div class="mt-6 flex w-full max-w-[335px] flex-col gap-2.5 sm:w-auto sm:max-w-none sm:flex-row lg:mt-[26px] lg:gap-3" data-hero-item>
      <a href="#demo" class="btn btn-light rounded-full bg-white px-8 py-4 text-[16px] font-medium text-ink">
        {t.hero.primary}
      </a>
      <a href="#pricing" class="btn btn-glass glass-dark rounded-full px-8 py-4 text-[16px] font-medium text-white">
        {t.hero.secondary}
      </a>
    </div>
  </div>

  <!-- Bottom fade: sky and clouds melt into the white page below -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 z-[15] h-[180px] bg-gradient-to-b from-white/0 via-white/70 to-white lg:h-[260px]"></div>

  <!-- Desktop composition (design: 1440 x 1240 frame, window at y630) -->
  <div class="relative mx-auto mt-[73px] hidden h-[610px] w-[1120px] select-none lg:block" role="img" aria-label={t.hero.productLabel}>
    <div aria-hidden="true">
      <Cloud name="far-l" x={-791} y={-257} parallax={140} />
      <Cloud name="far-r" x={324} y={-296} parallax={140} />
      <Cloud name="bank-l" x={-930} y={-58} parallax={70} />
      <Cloud name="bank-r" x={11} y={-25} parallax={70} />
      <div class="relative" data-hero-window><AppWindow t={t.app} /></div>
      <Cloud name="floor" x={-952} y={261} class="z-10" />
      <FloatCards t={t.floats} which="call" class="float absolute -top-[90px] -end-[90px] z-20" style="--d:0s" />
      <FloatCards t={t.floats} which="whatsapp" class="float absolute -top-[130px] -start-[110px] z-20" style="--d:1.2s" />
      <FloatCards t={t.floats} which="summary" class="float absolute top-[250px] -end-[106px] z-20" style="--d:2.1s" />
      <FloatCards t={t.floats} which="crm" class="float absolute top-[242px] -start-[112px] z-20" style="--d:0.6s" />
    </div>
  </div>

  <!-- Mobile and tablet: no product composition, just a soft cloud bank under the centred message -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-[300px] select-none lg:hidden" style="--cs:0.6">
    <Cloud name="far-l" x={-330} y={150} class="opacity-80" />
    <Cloud name="far-r" x={40} y={120} class="opacity-80" />
    <Cloud name="floor" x={-1030} y={250} />
  </div>
</section>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .wave-bar {
      animation: wave 1.1s ease-in-out infinite alternate;
    }
    .wave-bar:nth-child(3n) { animation-delay: -0.4s; }
    .wave-bar:nth-child(3n + 1) { animation-delay: -0.8s; }
  }
  @keyframes drift {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -8px; }
  }
  @keyframes wave {
    from { transform: scaleY(0.45); }
    to { transform: scaleY(1); }
  }
</style>

<script>
  import { animate, stagger } from "motion";
  import { ease, reducedMotion } from "../../scripts/motion";

  const root = document.getElementById("hero");
  if (root) {
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-hero-item]"));
    const [badge, heading, sub, ctas] = items;
    const windows = Array.from(root.querySelectorAll<HTMLElement>("[data-hero-window]"));
    const floats = Array.from(root.querySelectorAll<HTMLElement>(".float"));
    const bars = Array.from(root.querySelectorAll<HTMLElement>("[data-bar]"));
    const counts = Array.from(root.querySelectorAll<HTMLElement>("[data-count]"));

    if (reducedMotion()) {
      // Collapse the choreography: everything fades in together, no movement, no counting.
      animate([...items, ...windows, ...floats], { opacity: [0, 1] }, { duration: 0.4 });
      bars.forEach((b) => (b.style.transform = "none"));
    } else {
      // Beat 1: the message. Heading leads, the rest overlaps it as one wave.
      animate(badge, { opacity: [0, 1] }, { duration: 0.5 });
      animate(heading, { opacity: [0, 1], y: [20, 0], filter: ["blur(8px)", "blur(0px)"] }, { duration: 0.75, delay: 0.06, ease: ease.out });
      animate(sub, { opacity: [0, 1], y: [12, 0] }, { duration: 0.6, delay: 0.17, ease: ease.out });
      animate(ctas, { opacity: [0, 1], y: [8, 0] }, { duration: 0.6, delay: 0.26, ease: ease.out });

      // Beat 2: the product rises out of the clouds; its insides land as it settles.
      windows.forEach((w) => animate(w, { opacity: [0, 1], y: [56, 0] }, { duration: 1, delay: 0.38, ease: ease.out }));
      animate(bars, { transform: ["scaleY(0)", "scaleY(1)"] }, { duration: 0.7, delay: stagger(0.03, { startDelay: 0.68, ease: "easeOut" }), ease: ease.out });
      counts.forEach((el) => {
        const raw = el.dataset.count ?? "";
        const m = raw.match(/[\d.]+/);
        if (!m) return;
        const target = parseFloat(m[0]);
        const decimals = (m[0].split(".")[1] ?? "").length;
        const [before, after] = [raw.slice(0, m.index), raw.slice((m.index ?? 0) + m[0].length)];
        el.textContent = before + (0).toFixed(decimals) + after;
        animate(0, target, { duration: 1.1, delay: 0.7, ease: ease.out, onUpdate: (v) => (el.textContent = before + v.toFixed(decimals) + after) });
      });

      // Floating cards land as the window settles, with shrinking gaps (a wave, not a metronome).
      const delays = [0.76, 0.85, 0.92, 0.97];
      floats.forEach((f, i) =>
        animate(f, { opacity: [0, 1], y: [16, 0], scale: [0.96, 1] }, { duration: 0.65, delay: delays[i % 4], ease: ease.out }),
      );
    }
  }
</script>
