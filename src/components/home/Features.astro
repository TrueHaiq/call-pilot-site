---
// Bento grid on desktop; the same five cards become a swipeable carousel on small screens.
import type { HomeContent, Tone } from "../../i18n/home";
import Icon from "./Icon.astro";
import Cloud from "./Cloud.astro";

interface Props {
  t: HomeContent["features"];
}
const { t } = Astro.props;
const dot: Record<Tone, string> = { amber: "bg-amber", blue: "bg-sky-800", violet: "bg-violet", green: "bg-green", slate: "bg-ink-subtle" };
const chip: Record<Tone, { cls: string; icon: "phone" | "chat" | "sparkle" | "database" }> = {
  blue: { cls: "bg-amber-soft text-amber-ink", icon: "phone" },
  violet: { cls: "bg-sky-50 text-sky-800", icon: "sparkle" },
  green: { cls: "bg-green-soft text-green", icon: "chat" },
  amber: { cls: "bg-ink text-white", icon: "database" },
  slate: { cls: "bg-panel text-ink-muted", icon: "database" },
};
const card = "relative flex shrink-0 snap-start flex-col overflow-hidden w-[296px] h-[384px] rounded-[24px] p-[22px] lg:w-auto lg:rounded-[32px] lg:p-10";
const light = "border border-line bg-gradient-to-b from-[#f3f7fc] to-[#eaf1fa]";
const title = "text-[20px] font-semibold tracking-[-0.01em] lg:text-[26px]";
const desc = "mt-1.5 text-[14px] leading-[1.5] lg:mt-2.5 lg:text-[16px] lg:leading-[1.56]";
---

<section id="features" class="pb-[120px] lg:pb-[220px]">
  <div class="mx-auto max-w-[1200px] px-5 text-center">
    <h2 class="text-[28px] leading-[1.28] font-semibold tracking-[-0.018em] text-ink lg:text-[56px] lg:leading-[1.18]" data-reveal>
      {t.title[0]}<br />{t.title[1]}
    </h2>
    <p class="mx-auto mt-3 hidden max-w-[640px] text-[20px] text-balance text-ink-muted lg:block" data-reveal>{t.sub}</p>
  </div>

  <div
    class="no-scrollbar mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-5 px-5 lg:mx-auto lg:mt-16 lg:grid lg:max-w-[1240px] lg:grid-cols-12 lg:gap-6 lg:overflow-visible"
    role="region"
    aria-label={t.carouselLabel}
    tabindex="0"
    data-carousel
  >
    <!-- 1. Hebrew -->
    <article class:list={[card, "text-white lg:col-span-8 lg:h-[500px] lg:pt-11 lg:px-12"]} style="background: var(--sky-card)">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden lg:block" style="--cs:1.6">
        <Cloud name="far-r" x={-560} y={256} />
        <Cloud name="far-l" x={-10} y={256} />
      </div>
      <div aria-hidden="true" class="pointer-events-none absolute -top-[260px] h-[520px] w-[700px] ltr:-left-[120px] rtl:-right-[120px]" style="background: radial-gradient(closest-side, rgb(255 255 255 / 0.5), rgb(255 242 217 / 0.18) 40%, transparent)"></div>
      <div class="relative">
        <h3 class="text-[20px] font-semibold tracking-[-0.01em] lg:text-[28px]">{t.hebrew.title}</h3>
        <p class="mt-1.5 max-w-[400px] text-[14px] leading-[1.5] text-[#e6f0fc] lg:mt-2.5 lg:text-[17px] lg:leading-[1.53]">{t.hebrew.desc}</p>
      </div>
      <div class="relative mt-auto flex flex-col gap-2 rounded-[18px] border border-white bg-white/94 p-3 text-ink backdrop-blur-xl lg:w-[520px] lg:self-center lg:gap-2.5 lg:rounded-[20px] lg:px-[18px] lg:pt-4 lg:pb-[18px] lg:shadow-[0_18px_44px_-14px_rgb(15_58_122/0.16)]">
        <div class="flex items-center justify-between border-b border-line pb-2 lg:pb-2.5">
          <span class="text-[11px] text-ink-subtle lg:text-[12px]">{t.hebrew.live}</span>
          <span class="flex h-4 items-center gap-[2.5px]" dir="ltr" aria-hidden="true">
            {[5, 10, 16, 9, 18, 12, 7, 14, 8].map((h) => <span class="wave-bar w-[2.5px] rounded-full bg-amber" style={`height:${h * 0.85}px`}></span>)}
          </span>
        </div>
        {t.hebrew.lines.map((l) => (
          <div class:list={["flex", l.from === "agent" ? "justify-end" : "justify-start"]}>
            <p class:list={[
              "max-w-[200px] rounded-[12px] px-3 py-2 text-[13px] leading-[1.45] lg:max-w-none lg:rounded-[14px] lg:px-[13px] lg:py-[9px] lg:text-[14px]",
              l.from === "agent" ? "border border-line bg-white" : "bg-sky-50",
            ]}>
              <span class:list={["block text-[10px] font-medium lg:text-[11px]", l.from === "agent" ? "text-sky-800" : "text-ink-subtle"]}>
                {l.from === "agent" ? t.hebrew.agent : t.hebrew.customer}
              </span>
              <span lang="he" dir="rtl">{l.text}</span>
            </p>
          </div>
        ))}
      </div>
    </article>

    <!-- 2. One place -->
    <article class:list={[card, light, "lg:col-span-4 lg:h-[500px]"]}>
      <h3 class:list={[title, "text-ink lg:text-[28px]"]}>{t.timeline.title}</h3>
      <p class:list={[desc, "text-ink-muted lg:text-[17px]"]}>{t.timeline.desc}</p>
      <div class="mt-auto rounded-[16px] border border-line bg-white px-3.5 py-1.5 lg:-mx-2.5 lg:mt-6 lg:-mb-4 lg:rounded-[22px] lg:border-0 lg:px-[18px] lg:py-2 lg:shadow-[0_16px_36px_-8px_rgb(27_58_107/0.1)]">
        <div class="hidden items-center gap-2.5 border-b border-line py-3 lg:flex">
          <span class="grid size-9 place-items-center rounded-full bg-amber-soft text-[13px] font-semibold text-amber-ink">{t.timeline.customer.initials}</span>
          <span>
            <span class="block text-[15px] font-semibold text-ink">{t.timeline.customer.name}</span>
            <span class="block text-[12px] text-ink-muted">{t.timeline.customer.meta}</span>
          </span>
        </div>
        <ul>
          {t.timeline.events.map((e, i) => (
            <li class:list={["flex items-center gap-2.5 border-b border-line py-2.5 last:border-0 lg:gap-3 lg:py-[9px]", i === 3 && "max-lg:hidden"]}>
              <span class:list={["size-[7px] shrink-0 rounded-full lg:hidden", dot[e.tone]]}></span>
              <span class:list={["hidden size-[30px] shrink-0 place-items-center rounded-[9px] lg:grid", chip[e.tone].cls]}><Icon name={chip[e.tone].icon} size={15} /></span>
              <span class="min-w-0 flex-1">
                <span class="block text-[13px] font-medium text-ink lg:text-[14px]">{e.title}</span>
                <span class="block text-[11px] text-ink-subtle lg:text-[12px] lg:text-ink-muted">{e.meta}</span>
              </span>
              <span class="text-[11px] text-ink-subtle">{e.time}</span>
            </li>
          ))}
        </ul>
      </div>
    </article>

    <!-- 3. Automation -->
    <article class:list={[card, light, "lg:col-span-4 lg:h-[440px]"]}>
      <h3 class:list={[title, "text-ink"]}>{t.automation.title}</h3>
      <p class:list={[desc, "text-ink-muted"]}>{t.automation.desc}</p>
      <ul class="mt-auto rounded-[16px] border border-line bg-white px-3.5 py-1.5 lg:flex lg:flex-col lg:gap-2.5 lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0">
        {t.automation.steps.map((s) => (
          <li class:list={[
            "flex items-center justify-between gap-2 border-b border-line py-2.5 text-[13px] last:border-0",
            "lg:rounded-[14px] lg:border lg:bg-white lg:px-3.5 lg:py-[11px] lg:text-[14px] lg:shadow-[0_12px_28px_-6px_rgb(27_58_107/0.09)] lg:last:border",
            s.done ? "lg:border-transparent" : "lg:border-amber lg:border-[1.5px]",
          ]}>
            <span class:list={["flex items-center gap-2.5 text-ink", !s.done && "font-medium"]}>
              {s.done
                ? <span class="hidden size-5 place-items-center rounded-full bg-green text-white lg:grid"><Icon name="check" size={12} stroke={3} /></span>
                : <span class="spinner hidden size-5 rounded-full border-[2.5px] border-amber border-t-transparent lg:block" aria-hidden="true"></span>}
              {s.label}
            </span>
            <span class:list={["text-[11px] font-medium", s.done ? "text-green lg:hidden" : "text-amber-ink"]}>{s.done ? t.automation.done : t.automation.now}</span>
          </li>
        ))}
      </ul>
    </article>

    <!-- 4. Israel -->
    <article class:list={[card, light, "lg:col-span-4 lg:h-[440px]"]}>
      <h3 class:list={[title, "text-ink"]}>{t.israel.title}</h3>
      <p class:list={[desc, "text-ink-muted"]}>{t.israel.desc}</p>
      <div class="mt-auto">
        <div class="rounded-[16px] border border-line bg-white px-3.5 py-3 lg:rounded-[18px] lg:border-0 lg:px-5 lg:py-4 lg:shadow-[0_12px_28px_-6px_rgb(27_58_107/0.09)]">
          <p class="text-[12px] text-ink-subtle">{t.israel.numberLabel}</p>
          <p class="num mt-1 text-start text-[24px] font-semibold tracking-[0.01em] text-ink lg:text-[30px]">{t.israel.number}</p>
          <p class="mt-1 flex items-center gap-1.5 text-[12px] font-medium text-green"><span class="size-1.5 rounded-full bg-green"></span>{t.israel.status}</p>
        </div>
        <ul class="mt-3 flex flex-wrap gap-2 lg:mt-[18px]">
          {t.israel.chips.map((c) => <li class="rounded-full border border-line bg-white px-3 py-1.5 text-[12px] font-medium text-ink lg:text-[13px]">{c}</li>)}
        </ul>
      </div>
    </article>

    <!-- 5. Control -->
    <article class:list={[card, "text-white lg:col-span-4 lg:h-[440px]"]} style="background: var(--night-card)">
      <h3 class={title}>{t.control.title}</h3>
      <p class:list={[desc, "text-[#aebbd2]"]}>{t.control.desc}</p>
      <div class="mt-auto rounded-[16px] border border-white/8 bg-night-2 px-3.5 py-1.5 lg:rounded-[18px] lg:px-4">
        <div class="border-b border-white/10 py-2.5 lg:py-3">
          <p class="text-[10px] font-medium text-[#f0b85a] lg:text-[11px]">{t.control.agent}</p>
          <p class="mt-0.5 text-[13px] leading-[1.45] lg:text-[14px]">{t.control.message}</p>
        </div>
        <div class="flex items-center gap-2.5 border-b border-white/10 py-2.5 max-lg:border-0 lg:py-3">
          <span class="hidden size-[30px] place-items-center rounded-full bg-[#2c4475] text-[11px] font-semibold lg:grid">{t.control.handoffInitials}</span>
          <span class="min-w-0 flex-1">
            <span class="block text-[13px] font-medium lg:text-[14px]">{t.control.handoff}</span>
            <span class="block text-[11px] text-[#aebbd2] lg:text-[12px]">{t.control.handoffMeta}</span>
          </span>
          <span class="text-[11px] font-medium text-amber lg:text-[12px]">{t.control.now}</span>
        </div>
        <div class="hidden items-center justify-between py-3 text-[12px] lg:flex">
          <span class="text-[#aebbd2]">{t.control.knowledge}</span>
          <span class="font-medium">{t.control.knowledgeValue}</span>
        </div>
      </div>
    </article>
  </div>

  <div class="mt-6 flex justify-center gap-1.5 lg:hidden" aria-hidden="true" data-carousel-dots>
    {Array.from({ length: 5 }).map((_, i) => <span class:list={["h-1.5 rounded-full bg-ink transition-all duration-300", i === 0 ? "w-[18px]" : "w-1.5 opacity-20"]}></span>)}
  </div>
</section>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .spinner { animation: spin 0.9s linear infinite; }
  }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
  // Keep the carousel dots in sync with the visible card (works in both reading directions).
  const track = document.querySelector<HTMLElement>("[data-carousel]");
  const dots = Array.from(document.querySelectorAll<HTMLElement>("[data-carousel-dots] > span"));
  if (track && dots.length) {
    const cards = Array.from(track.children) as HTMLElement[];
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const i = cards.indexOf(e.target as HTMLElement);
          dots.forEach((d, j) => {
            d.classList.toggle("w-[18px]", i === j);
            d.classList.toggle("w-1.5", i !== j);
            d.classList.toggle("opacity-20", i !== j);
          });
        }
      },
      { root: track, threshold: 0.6 },
    );
    cards.forEach((c) => io.observe(c));
  }
</script>
