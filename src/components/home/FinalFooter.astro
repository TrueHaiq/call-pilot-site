---
import type { HomeContent } from "../../i18n/home";
import Logo from "./Logo.astro";
import Cloud from "./Cloud.astro";

interface Props {
  t: HomeContent;
}
const { t } = Astro.props;
---

<div class="relative overflow-hidden" style="background: var(--sky-footer)" data-parallax-root>
  <!-- Cloud ceiling: the page climbs through the clouds into the sky -->
  <div aria-hidden="true" data-parallax="80" data-parallax-range="enter" class="pointer-events-none absolute inset-x-0 top-0 h-[520px] [--cs:0.75] lg:[--cs:1]" style="mask-image: linear-gradient(to bottom, transparent 0, black 160px); -webkit-mask-image: linear-gradient(to bottom, transparent 0, black 160px)">
    <Cloud name="floor" x={-1004} y={-170} flip />
    <Cloud name="bank-l" x={-1140} y={-10} class="opacity-85" />
    <Cloud name="bank-r" x={260} y={-40} class="opacity-85" />
  </div>

  <section id="demo" class="relative flex flex-col items-center px-5 pt-[260px] text-center text-white lg:pt-[400px]">
    <h2 class="text-[36px] leading-[1.22] font-bold tracking-[-0.02em] lg:text-[72px] lg:leading-[1.15]" data-reveal>
      {t.final.title[0]}<br />{t.final.title[1]}
    </h2>
    <p class="mt-4 max-w-[310px] text-[16px] leading-[1.56] text-white/90 sm:max-w-none lg:mt-6 lg:text-[20px]">{t.final.sub}</p>
    <div class="mt-6 flex w-full max-w-[335px] flex-col gap-2.5 sm:w-auto sm:max-w-none sm:flex-row lg:mt-8 lg:gap-3">
      <a href="#demo" class="btn btn-light rounded-full bg-white px-[30px] py-4 text-[16px] font-medium text-ink lg:text-[17px]">
        {t.final.primary}
      </a>
      <a href="#pricing" class="btn btn-glass glass-dark rounded-full px-[28px] py-4 text-[16px] font-medium text-white lg:text-[17px]">
        {t.final.secondary}
      </a>
    </div>
  </section>

  <footer class="relative mx-auto mt-[72px] max-w-[1120px] px-5 text-white lg:mt-[100px] lg:px-0">
    <div class="flex flex-col gap-7 border-t border-white/25 pt-8 lg:flex-row lg:justify-between lg:rtl:flex-row-reverse lg:gap-0 lg:pt-10">
      <div class="flex flex-col gap-4 max-lg:items-center">
        <Logo size="md" />
        <p class="hidden text-[14px] text-white/75 lg:block">{t.footer.copyright}</p>
      </div>
      <nav aria-label="Footer" class="grid grid-cols-3 gap-4 lg:flex lg:gap-24">
        {t.footer.columns.map((col) => (
          <div>
            <p class="text-[14px] font-semibold lg:text-[15px]">{col.title}</p>
            <ul class="mt-3 flex flex-col gap-3 lg:mt-3.5 lg:gap-3.5">
              {col.links.map((l) => <li><a href="#" class="rounded text-[14px] text-white/80 hover:text-white lg:text-[15px]">{l}</a></li>)}
            </ul>
          </div>
        ))}
      </nav>
      <p class="text-[13px] text-white/75 lg:hidden">{t.footer.copyright}</p>
    </div>
  </footer>

  <p
    aria-hidden="true"
    dir="ltr"
    data-reveal
    class="relative mt-6 -mb-[0.24em] text-center font-wordmark text-[17.5vw] leading-[0.8] font-black tracking-[-0.015em] text-transparent select-none lg:mt-10 lg:text-[262px]"
    style="background: linear-gradient(180deg, rgb(255 255 255 / 0.32), rgb(255 255 255 / 0.02)); -webkit-background-clip: text; background-clip: text;"
  >CALLPILOT</p>
</div>
