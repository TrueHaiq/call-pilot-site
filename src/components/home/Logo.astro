---
// Brand lockup: cap mark (masked PNG, takes currentColor) + Nunito Black wordmark.
// Always laid out left-to-right: it is a Latin wordmark, also inside Hebrew pages.
interface Props {
  size?: "sm" | "md" | "lg";
  class?: string;
}
const { size = "md", class: cls } = Astro.props;
const dims = {
  sm: { mark: "w-[26px] h-[23px]", text: "text-[16px]", gap: "gap-2" },
  md: { mark: "w-[38px] h-[34px]", text: "text-[20px]", gap: "gap-3" },
  lg: { mark: "w-[44px] h-[39px]", text: "text-[24px]", gap: "gap-3.5" },
}[size];
---

<span dir="ltr" class:list={["inline-flex items-center", dims.gap, cls]}>
  <span class:list={["logo-mark shrink-0", dims.mark]} aria-hidden="true"></span>
  <span class:list={["font-wordmark font-black leading-none tracking-[0.03em] [text-box:trim-both_cap_alphabetic]", dims.text]}>CALLPILOT</span>
</span>
